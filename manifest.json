{
  "manifest_version": 3,
  "name": "CineCanvas",
  "version": "0.3.2",
  "description": "Get the most out of your 21:9 ultrawide screen: Smart scaling, soft edge blending, and ambient lighting strictly for YouTube.",
  "permissions": ["storage", "activeTab"],
  "browser_specific_settings": {
    "gecko": {
      "id": "cinecanvas@local.dev",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CineCanvas",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "cycle-mode": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Zyklisch durch Bild- und Ambilight-Modi wechseln"
    },
    "toggle-wings": {
      "suggested_key": {
        "default": "Alt+W"
      },
      "description": "Flügel-Icons / Overlays ein- oder ausschalten"
    },
    "toggle-theme": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Flügel-Theme zwischen Dunkel und Hell umschalten"
    },
    "toggle-autocrop": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Auto-Crop Erkennung ein- oder ausschalten"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}